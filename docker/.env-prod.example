# Copy to docker/.env-prod and fill in real values. Do NOT commit the real file.

# --- External PostgreSQL (Superset metadata DB) ---
DATABASE_HOST=postgres.seu-dominio.local
DATABASE_PORT=5432
DATABASE_DB=superset
DATABASE_USER=superset
DATABASE_PASSWORD=trocar-aqui
DATABASE_DIALECT=postgresql
# Use require/prefer/disable conforme seu Postgres. Deixe vazio quando não precisar.
DATABASE_SSL_MODE=

# --- Superset core ---
# Gere com: openssl rand -base64 42   (NUNCA mude depois de subir)
SUPERSET_SECRET_KEY=trocar-por-string-aleatoria-longa
# Use somente ao trocar a chave em um metadata DB já existente.
# Depois de um start bem-sucedido, remova ou comente esta variável.
# PREVIOUS_SECRET_KEY=chave-antiga-que-criptografou-as-conexoes
# Gere com outro valor aleatório se usar embedded dashboards.
GUEST_TOKEN_JWT_SECRET=trocar-por-string-aleatoria-longa-diferente
SUPERSET_APP_NAME=linhalis
SUPERSET_LOGO_TOOLTIP=linhalis

# Porta exposta no host
SUPERSET_PORT=8088
SUPERSET_ENABLE_PROXY_FIX=true
SUPERSET_PREFERRED_URL_SCHEME=https

# --- Keycloak / OAuth ---
# No Keycloak, cadastre o redirect URI:
# https://SEU_DOMINIO/oauth-authorized/keycloak
KEYCLOAK_ENABLED=false
KEYCLOAK_BASE_URL=https://keycloak.seu-dominio.com
KEYCLOAK_REALM=linhalis
KEYCLOAK_CLIENT_ID=superset
KEYCLOAK_CLIENT_SECRET=trocar-aqui
# Texto exato do botao no login. Alternativa: Linhalis Account
KEYCLOAK_PROVIDER_LABEL=Conta Linhalis
KEYCLOAK_SCOPE=openid email profile
KEYCLOAK_USER_REGISTRATION=true
KEYCLOAK_USER_REGISTRATION_ROLE=Gamma
KEYCLOAK_ROLES_SYNC_AT_LOGIN=true
# Crie essas roles no Keycloak como realm roles ou client roles do client superset.
# Mapeia roles do Keycloak para roles internas do Superset.
KEYCLOAK_ROLE_MAPPING={"superset_admin":["Admin"],"superset_alpha":["Alpha"],"superset_gamma":["Gamma"]}

# --- Redis existente ---
REDIS_HOST=192.168.15.74
REDIS_PORT=6379
REDIS_CELERY_DB=0
REDIS_RESULTS_DB=1
# REDIS_PASSWORD=

# --- Admin inicial (criado no primeiro start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=trocar-aqui
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Superset
ADMIN_LASTNAME=Admin
# Depois do primeiro deploy, defina como true para evitar tentativa de recriação
SUPERSET_SKIP_ADMIN_CREATE=false

# --- Embed / CORS ---
SUPERSET_ENABLE_CORS=true
SUPERSET_CORS_ORIGINS=*
SUPERSET_TALISMAN_ENABLED=false
SUPERSET_X_FRAME_OPTIONS=ALLOWALL

# --- Opcionais ---
# MAPBOX_API_KEY=
# SUPERSET_LOG_LEVEL=info
# SERVER_WORKER_AMOUNT=4
# GUNICORN_TIMEOUT=120
